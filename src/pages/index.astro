---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="HƯNG THUẬN - Trang chủ"
  description="Hưng Thuận Vải & Ren — hơn 10 năm kinh nghiệm cung cấp vải ren, lụa, linen cao cấp sỉ và lẻ tại Tân Bình, TP.HCM."
  current="home"
>
  <!-- Hero Section -->
  <section
    class="relative bg-surface-container-low text-primary overflow-hidden"
    style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDWTxsrUbSqzRIXRC2-FijBwMagemPjV_asqIR9Nu46tsOjkoGlyY_YhXooELsorU9FMlF8_Tw7eD_qxt6AygSIdZvNpSqxI7wtBimMvBDXDpf7wWR19oxhkS2gHPQ4GeFzAXwJDQIoOqn8hwatMwrcZe_Z-MkTXunS5FfXC1fu-6LpFYWJOuSM_pPkFW6Tq4nwbhlOu96u7uyRkPZcIzQoriB2ATKnZTPcmwGxjiRXSyqyMibgnBc'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-surface-container-lowest/40 to-surface-container/60 pointer-events-none"></div>
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-32 md:py-48 flex flex-col items-center text-center relative z-10">
      <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg mb-6 max-w-4xl leading-tight text-surface-cream">
        Làm tốt một việc: <span class="italic font-light opacity-90 text-secondary">bán vải</span>
      </h1>
      <p class="font-body-lg text-body-lg max-w-2xl mb-12 text-surface-bone">
        Hơn 10 năm kinh nghiệm tuyển chọn và cung cấp vải cao cấp. Chúng tôi tin vào vẻ đẹp của chất liệu và sự bền bỉ của một dịch vụ tận tâm.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a class="bg-primary text-on-primary px-8 py-4 font-label-caps text-label-caps uppercase tracking-wider hover:bg-ink-warm rounded-full shadow-sm hover:shadow-md transition-all duration-300" href="/san-pham">Xem Sản Phẩm</a>
        <a class="bg-transparent text-primary px-8 py-4 font-label-caps text-label-caps uppercase tracking-wider border border-outline-variant rounded-full hover:bg-surface-container-lowest transition-all duration-300" href="/lien-he">Liên Hệ Ngay</a>
      </div>
    </div>
    <div class="absolute bottom-4 right-4 md:bottom-8 md:right-8 opacity-60 font-label-caps text-label-caps text-outline">
      MÃ VẢI: HT-2024 / CHẤT LIỆU: LINEN CAO CẤP
    </div>
  </section>

  <!-- Swatch Band -->
  <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop pt-16 pb-8 text-center">
    <div class="w-12 h-px bg-outline-variant/50 mx-auto mt-4"></div>
  </div>
  <section class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop pb-24">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-8">
      <div class="aspect-4/5 overflow-hidden rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
        <img alt="Premium embroidered French lace" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD5lJu1FIrSVnjhO2siVcud9JjzvZSElQbK-YJ2I_jGlVsWlk8-8x20FHbpwXLXLn1Lebc2qZrtZzPDauGRlB4ozCZie1Ghj9zSfBQmw5EFMTZLFXiwtMZQwa9B9FD4yttTHWzb85OJpPUcl36vYqleC41PLcIls-QSRctxG7N_LeXxsd5cRqM6WHkNG71aauFcs6FseALJXRSJ3f9Z6LBLqyyE0FFkue0SopTV7YGZ91Nr_JdUERY" />
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
        <img alt="Premium heavy-weight silk satin" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCtpVTYOMa7J-f9nwUOvtNdIIrWf4rn5QCm3IrU8SJyvL1z4tRh4s42cIimr-FL4gAIA_luHiZ8TCTMZ5UAR9sOVulyD1tGFn0hQoL78MfmHFVm2_aTHzsQ3it_Y293PFYTnSlyhCxO4OOuU4IAMY3v2vC383Uq9vIgs0pGpmeknm58QbXCyTWNOCVzT-HqRbwv8QbZvcUulf9hnqUEW2nI42OKPCG_0zRj5y47zAO4CIu4r_icofw" />
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
        <img alt="High-end raw slub linen" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCgTAgwieR5CJGF_I_LMDBX1UWVYbr8xOPPQnQDl0G53kiikgvMxhFkrjjyW0JojztzXN3wAkVa5VYjVULpnMMhSXyenFLFn92cMiBfgvRIloPtA5sOxwpcnTvTVTqHnwbhC1g5II5GjLFiVWjOUgaA4VNERyHAIelCC5kmNDTnsro1lNrZnOIx0Fg3xX775Eo-3rc1rJl5WWgpbjPT8pTPDleLIBni4f9Jobew5qhtmfzDnQpeKow" />
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
        <img alt="Premium floral brocade" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCZy2TPND7-YFuaM9l-ACsRBHRny121LuLzBv-qU6zr1sa6ZLvSa2s_j9B3KZ-sXsmCT3vhWEkmReYxFvAx95MJzXqslmZjlPluNUsVIW3RWtrorrkABa83biru5T4KS0EuOckyqNtQxh-fYd89Q59joOJw2d4SbT3T0GBtTucKVZP4Ffa_cGQJmxpCqPHRHOacGCOLUx0etqn6Ckwkjr2cp4fvx6TvrgMMFIrkJS_5fV9U_p6ZAmo" />
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
        <img alt="Luxury metallic-fleck tweed" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAnHYkOtvsxENwNRa2AswtKyJ_64HVqtUREK18pdNyyokk2J_2n6i0udYcKP5X26SZu3zF3-pnJwm_7YOa9WwunsBZxUdWVjnkRQG4X9f8R5JyNNEZL4MhtU4xP8KvOxTnW1FSDQwGmFbxhqPhP8ItTLve-TTacMz1sHjaFklKKFJsqOo8_v38J72_IfAY-D3zmTbsLBlHfDIfzJIPSV_IvVfARRFoIMdvK54DDd-72ca5Q5KuXZtM" />
      </div>
      <div class="aspect-4/5 overflow-hidden rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
        <img alt="Delicate cotton eyelet lace" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBVXqiHE9p3pKIj3Ap1z0HA3Tn9eV60GCvZryK4T9o7ydpLgWc6xEONthWTXV4cl1CuBB-fesq_vzrBh6jGwZj4OsgRX7_IhgLbT8GNnjRm2WARY77CMawQ3TcuJSnHAeS30ZNnrtNHVIW-X0v2kMwGyWtAlzLQky7fga90dlZrYfbRlcisA0bhpINpO8GSzwVEWZHMOEQR1aaGxCcT2_LThfOmVgiKtK6ePGs4b45lMXclx5CLjA8" />
      </div>
    </div>
  </section>

  <!-- Cách chúng tôi phục vụ -->
  <section class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-24">
    <div class="text-center mb-16">
      <span class="font-label-caps text-label-caps text-secondary uppercase block mb-4 tracking-widest">Cách Chúng Tôi Phục Vụ</span>
      <div class="w-12 h-px bg-outline-variant/50 mx-auto mb-6"></div>
      <h2 class="font-headline-md text-headline-md text-ink-warm">Quy trình làm việc tận tâm</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
      <div class="p-8 rounded-2xl bg-surface-container-lowest border border-surface-variant shadow-[0_4px_20px_-4px_rgba(228,221,209,0.5)] hover:shadow-[0_8px_30px_-4px_rgba(228,221,209,0.7)] transition-shadow duration-300">
        <span class="material-symbols-outlined text-4xl text-secondary mb-6 block font-light">store</span>
        <h3 class="font-label-caps text-label-caps uppercase mb-4 text-ink-warm">Sỉ &amp; Lẻ Tận Tâm</h3>
        <p class="font-body-sm text-body-sm leading-relaxed text-surface-bone">Phục vụ đa dạng nhu cầu từ cá nhân đến xưởng may lớn với chính sách linh hoạt.</p>
      </div>
      <div class="p-8 rounded-2xl bg-surface-container-lowest border border-surface-variant shadow-[0_4px_20px_-4px_rgba(228,221,209,0.5)] hover:shadow-[0_8px_30px_-4px_rgba(228,221,209,0.7)] transition-shadow duration-300">
        <span class="material-symbols-outlined text-4xl text-secondary mb-6 block font-light">search</span>
        <h3 class="font-label-caps text-label-caps uppercase mb-4 text-ink-warm">Tìm Kiếm Chuyên Sâu</h3>
        <p class="font-body-sm text-body-sm leading-relaxed text-surface-bone">Hỗ trợ tìm kiếm các dòng vải đặc thù, hiếm có theo yêu cầu riêng biệt của khách hàng.</p>
      </div>
      <div class="p-8 rounded-2xl bg-surface-container-lowest border border-surface-variant shadow-[0_4px_20px_-4px_rgba(228,221,209,0.5)] hover:shadow-[0_8px_30px_-4px_rgba(228,221,209,0.7)] transition-shadow duration-300">
        <span class="material-symbols-outlined text-4xl text-secondary mb-6 block font-light">inventory_2</span>
        <h3 class="font-label-caps text-label-caps uppercase mb-4 text-ink-warm">Nguồn Cung Ổn Định</h3>
        <p class="font-body-sm text-body-sm leading-relaxed text-surface-bone">Cam kết duy trì số lượng lớn và chất lượng đồng đều cho các đơn hàng dài hạn.</p>
      </div>
      <div class="p-8 rounded-2xl bg-surface-container-lowest border border-surface-variant shadow-[0_4px_20px_-4px_rgba(228,221,209,0.5)] hover:shadow-[0_8px_30px_-4px_rgba(228,221,209,0.7)] transition-shadow duration-300">
        <span class="material-symbols-outlined text-4xl text-secondary mb-6 block font-light">handshake</span>
        <h3 class="font-label-caps text-label-caps uppercase mb-4 text-ink-warm">Đối Tác Trách Nhiệm</h3>
        <p class="font-body-sm text-body-sm leading-relaxed text-surface-bone">Luôn đồng hành và chịu trách nhiệm đến cùng với từng mét vải giao đi.</p>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-surface-container-high text-ink-warm py-20 border-y border-outline-variant/30">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-outline-variant/40">
      <div class="px-4">
        <div class="font-headline-md text-headline-md mb-2 text-primary">10+</div>
        <div class="font-label-caps text-label-caps text-secondary uppercase">Năm kinh nghiệm</div>
      </div>
      <div class="px-4">
        <div class="font-headline-md text-headline-md mb-2 text-primary">2.000+</div>
        <div class="font-label-caps text-label-caps text-secondary uppercase">Mã vải &amp; ren</div>
      </div>
      <div class="px-4">
        <div class="font-headline-md text-headline-md mb-2 text-primary">800+</div>
        <div class="font-label-caps text-label-caps text-secondary uppercase">Đối tác tin cậy</div>
      </div>
      <div class="px-4">
        <div class="font-headline-md text-headline-md mb-2 text-primary">Sỉ &amp; Lẻ</div>
        <div class="font-label-caps text-label-caps text-secondary uppercase">Phục vụ tận tâm</div>
      </div>
    </div>
  </section>
</Layout>
