---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Liên hệ - HƯNG THUẬN"
  description="Liên hệ Hưng Thuận Vải & Ren — showroom tại 20 Tân Phước, P.8, Q. Tân Bình, TP.HCM. Hotline/Zalo: 0869 927 688."
  current="contact"
>
  <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-24">
    <div class="text-center mb-20">
      <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary mb-6">Liên hệ</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Ghé thăm showroom hoặc nhắn tin cho chúng tôi
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
      <!-- Contact Info -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-variant p-6 flex flex-col gap-4 sm:col-span-2 hover:shadow-md transition-shadow duration-300">
            <span class="material-symbols-outlined text-secondary">store</span>
            <div>
              <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-2 uppercase">Showroom</h3>
              <p class="font-body-md text-body-md text-on-surface">20 Tân Phước, P.8, Q. Tân Bình, TP. HCM</p>
            </div>
          </div>
          <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-variant p-6 flex flex-col gap-4 hover:shadow-md transition-shadow duration-300">
            <span class="material-symbols-outlined text-secondary">call</span>
            <div>
              <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-2 uppercase">Hotline</h3>
              <p class="font-body-md text-body-md text-on-surface">0869 927 688</p>
            </div>
          </div>
          <a
            href="https://zalo.me/84869927688"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-variant p-6 flex flex-col gap-4 hover:shadow-md hover:border-secondary transition-all duration-300"
          >
            <span class="material-symbols-outlined text-secondary">chat</span>
            <div>
              <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-2 uppercase">Zalo</h3>
              <p class="font-body-md text-body-md text-on-surface">0869 927 688</p>
            </div>
          </a>
          <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-variant p-6 flex flex-col gap-4 sm:col-span-2 hover:shadow-md transition-shadow duration-300">
            <span class="material-symbols-outlined text-secondary">mail</span>
            <div>
              <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-2 uppercase">Email</h3>
              <p class="font-body-md text-body-md text-on-surface">hungthuan20tp@gmail.com</p>
            </div>
          </div>
        </div>
        <div class="mt-8 border-t border-outline-variant/30 pt-8">
          <h2 class="font-headline-sm text-headline-sm text-primary mb-6">Giờ mở cửa</h2>
          <div class="flex justify-between items-center border-b border-outline-variant/30 pb-2">
            <span class="font-label-caps text-label-caps text-on-surface-variant">DAILY</span>
            <span class="font-body-md text-body-md text-on-surface">07:00 – 18:00</span>
          </div>
        </div>
      </div>
      <!-- Map -->
      <div class="lg:col-span-7 bg-surface-container-lowest rounded-xl shadow-sm border border-surface-variant overflow-hidden h-[400px] lg:h-auto min-h-[500px]">
        <div class="w-full h-full bg-surface-dim flex items-center justify-center relative overflow-hidden">
          <img
            class="absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-multiply"
            alt="Bản đồ vị trí showroom Hưng Thuận"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuA6PuhyYJ-v7zVAqBfoVo8Ut3esZtGEG5mv21bFmGgPp8z6PeJWEKQ9OBXuc7Xh5juyzQaOj_AJpWbX9fq7ADl2tdhsQ8XwzzNbQtebI9iewd7gYNTOopmc-krW-N37Mu_Tz2__IiLMI17lbo2WUcrEY-jgXZjRJP25PSDIIbxoeOgdmA_-ZOVWiMAHEwCVaoOwil-tO7pgH2o9eTDXf5Hgb-zBgqkhY-eNuKWstusB6qTTMuwHGeg"
          />
          <div class="absolute z-10 bg-surface/90 backdrop-blur-sm px-6 py-3 rounded-full border border-secondary/20 shadow-sm">
            <span class="font-label-caps text-label-caps text-primary tracking-widest">MAP PLACEHOLDER</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
