---

<Layout title="HƯNG THUẬN - Sản phẩm" current="products">
  <div class="max-w-max-width mx-auto w-full px-margin-mobile md:px-margin-desktop py-32">
    <header class="mb-16 text-center">
      <h1 class="font-display-lg text-display-lg text-primary mb-4">Kho hàng sỉ &amp; lẻ</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Khám phá bộ sưu tập vải đa dạng của chúng tôi. Giá cả được báo theo yêu cầu cụ thể qua Zalo hoặc điện thoại để đảm bảo mức chiết khấu tốt nhất cho số lượng của bạn.
      </p>
    </header>

    <!-- Filters -->
    <div class="mb-16 flex flex-wrap gap-3 justify-center" data-filter-bar>
      {filters.map((label, i) => (
        <button
          type="button"
          class="js-filter-btn px-6 py-2 font-label-caps text-label-caps rounded-full transition-colors duration-300 bg-surface-container text-on-surface-variant hover:bg-surface-container-high hover:text-primary data-[active=true]:bg-secondary data-[active=true]:text-on-secondary data-[active=true]:hover:bg-surface-tint"
          data-filter={label}
          data-active={i === 0 ? "true" : "false"}
        >
          {label}
        </button>
      ))}
    </div>

    <p class="js-filter-empty hidden text-center font-body-md text-body-md text-on-surface-variant mb-16">
      Chưa có mẫu vải nào trong danh mục này. Vui lòng chọn danh mục khác hoặc liên hệ để được tư vấn thêm.
    </p>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-filter-grid>
      {products.map((product) => (
        <article class="js-product-card bg-surface-container-lowest rounded-2xl p-6 flex flex-col relative group soft-shadow border border-surface-container-high" data-gallery data-tag={product.tag}>
          <div class="aspect-4/5 w-full bg-surface-variant mb-3 rounded-xl overflow-hidden relative">
            <img
              class="gallery-main-img w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              alt={product.name}
              src={product.images[0]}
            />
          </div>

          {product.images.length > 1 && (
            <div class="flex gap-2 mb-6">
              {product.images.map((src, i) => (
                <button
                  type="button"
                  class="gallery-thumb w-12 h-12 rounded-lg overflow-hidden border-2 border-transparent opacity-60 hover:opacity-100 data-[active=true]:border-primary data-[active=true]:opacity-100 transition-all"
                  data-src={src}
                  data-active={i === 0 ? "true" : "false"}
                  aria-label={`Xem ảnh ${i + 1} của ${product.name}`}
                >
                  <img class="w-full h-full object-cover" src={src} alt="" />
                </button>
              ))}
            </div>
          )}
          {product.images.length <= 1 && <div class="mb-6" />}

          <div class="flex justify-between items-start mb-2">
            <span class="font-label-caps text-label-caps text-secondary bg-surface-container px-2 py-1 rounded">{product.tag}</span>
            <span class="font-label-caps text-label-caps text-outline">{product.code}</span>
          </div>
          <h2 class="font-headline-sm text-headline-sm text-primary mb-2">{product.name}</h2>
          <div class="font-label-caps text-label-caps text-outline flex flex-col gap-1 mb-4">
            <span>{product.spec}</span>
          </div>
          <p class="font-body-sm text-body-sm text-on-surface-variant mb-6 flex-grow">
            {product.desc}
          </p>
          <div class="mb-6">
            <span class="font-label-caps text-label-caps text-secondary mb-3 block">GỢI Ý ỨNG DỤNG</span>
            <div class="flex gap-2">
              {product.tags.map((t) => (
                <div class="w-10 h-10 bg-surface border border-surface-container-high rounded-full flex items-center justify-center group/tooltip relative">
                  <span class="material-symbols-outlined text-on-surface-variant text-[18px]">{t.icon}</span>
                  <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-inverse-surface text-inverse-on-surface text-xs px-2 py-1 rounded opacity-0 group-hover/tooltip:opacity-100 transition-opacity whitespace-nowrap">{t.label}</span>
                </div>
              ))}
            </div>
          </div>
          <ColorSwatches codes={product.colors ?? []} />
          <a
            class="inline-flex items-center justify-center w-full py-3 bg-surface-container text-primary font-label-caps text-label-caps rounded-lg hover:bg-primary-container hover:text-on-primary-container transition-colors duration-300"
            href="https://zalo.me/84869927688"
            target="_blank"
            rel="noopener noreferrer"
          >HỎI GIÁ QUA ZALO</a>
        </article>
      ))}
    </div>
  </div>
</Layout>

<script>
  // Chuyển ảnh chính khi bấm vào thumbnail (bấm 1 lần cho toàn trang, áp dụng cho mọi thẻ sản phẩm)
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".gallery-thumb");
    if (!btn) return;

    const gallery = btn.closest<HTMLElement>("[data-gallery]");
    const mainImg = gallery?.querySelector<HTMLImageElement>(".gallery-main-img");
    const src = btn.dataset.src;
    if (!gallery || !mainImg || !src) return;

    mainImg.src = src;
    gallery.querySelectorAll<HTMLButtonElement>(".gallery-thumb").forEach((t) => {
      t.dataset.active = t === btn ? "true" : "false";
    });
  });

  // Lọc sản phẩm theo danh mục khi bấm nút filter
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".js-filter-btn");
    if (!btn) return;

    const bar = btn.closest<HTMLElement>("[data-filter-bar]");
    const grid = document.querySelector<HTMLElement>("[data-filter-grid]");
    const emptyMsg = document.querySelector<HTMLElement>(".js-filter-empty");
    if (!bar || !grid) return;

    bar.querySelectorAll<HTMLButtonElement>(".js-filter-btn").forEach((b) => {
      b.dataset.active = b === btn ? "true" : "false";
    });

    const filter = btn.dataset.filter;
    let visibleCount = 0;
    grid.querySelectorAll<HTMLElement>(".js-product-card").forEach((card) => {
      const match = filter === "TẤT CẢ" || card.dataset.tag === filter;
      card.classList.toggle("hidden", !match);
      if (match) visibleCount++;
    });

    emptyMsg?.classList.toggle("hidden", visibleCount > 0);
  });
</script>
