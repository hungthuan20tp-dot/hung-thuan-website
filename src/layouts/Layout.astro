---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  current: "home" | "about" | "products" | "contact";
}

const {
  title,
  current,
  description = "Hưng Thuận Vải & Ren — chuyên cung cấp sỉ và lẻ vải ren, lụa, linen cao cấp tại Tân Bình, TP.HCM. Hơn 10 năm kinh nghiệm, tư vấn qua Zalo.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/images/logo/hung-thuan-logo.png", Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "Hưng Thuận Vải & Ren",
  image: ogImageURL.toString(),
  url: Astro.site?.toString(),
  telephone: "+84869927688",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "20 Tân Phước, P.8",
    addressLocality: "Quận Tân Bình",
    addressRegion: "TP. Hồ Chí Minh",
    addressCountry: "VN",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "07:00",
    closes: "18:00",
  },
  sameAs: ["https://zalo.me/84869927688"],
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="google-site-verification" content="emSbvKhReDt9y5F5sGtOemcs0wVmxPce7PDNlPnugSY" />
    <meta name="google-site-verification" content="yRXuEoyqS_1st_10nvwh4U6aEpJoNNYzcVFbSWjdjic" />

    <!-- Open Graph / Facebook, Zalo -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HƯNG THUẬN VẢI & REN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="vi_VN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-background text-on-background antialiased min-h-screen flex flex-col">
    <Header current={current} />
    <main class="flex-grow pt-24">
      <slot />
    </main>
    <Footer />
  </body>
</html>
